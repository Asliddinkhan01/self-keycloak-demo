<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>uz.platform</groupId>
        <artifactId>oneid-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>api-gateway</artifactId>
    <name>api-gateway</name>
    <description>Single entry point: routing, CORS, edge token validation</description>

    <dependencies>
        <!--
            The SERVLET gateway, not the reactive one.

            Spring Cloud ships both. The reactive gateway performs better under
            very high concurrency, and it would force a second security model
            into this project: reactive Spring Security uses SecurityWebFilterChain
            and cannot reuse the servlet SecurityFilterChain in platform-security.
            One security model everywhere is worth more here than throughput at a
            scale this platform will not see.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webmvc</artifactId>
        </dependency>

        <!--
            The gateway validates tokens at the edge, so it needs the resource
            server half of platform-security. It deliberately does NOT import
            PermissionSecurity: it has no database and makes no business
            authorization decision.
        -->
        <dependency>
            <groupId>uz.platform</groupId>
            <artifactId>platform-security</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
