# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Nothing here is a real credential. The OneID values are placeholders until
# the operator issues real ones by email, per the technical instruction.
# ---------------------------------------------------------------------------

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5452

# ---- Keycloak -------------------------------------------------------------
KEYCLOAK_PORT=8190
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# The public URL of Keycloak. This becomes the "iss" claim of every token and
# must match issuer-uri in every service, character for character.
KEYCLOAK_HOSTNAME_URL=http://localhost:8190
KEYCLOAK_REALM=platform

# ---- OneID ----------------------------------------------------------------
# Local development points at the mock, which speaks the same wire protocol.
# Production: https://sso.egov.uz
ONEID_BASE_URL=http://mock-oneid:8080
ONEID_AUTHORIZATION_PATH=/sso/oauth/Authorization.do
ONEID_CLIENT_ID=CHANGE_ME
ONEID_CLIENT_SECRET=CHANGE_ME
ONEID_SCOPE=CHANGE_ME
# The specification forbids "localhost" in redirect_uri against real OneID.
# Locally this points at Keycloak's broker endpoint; for a real integration it
# must be a resolvable HTTPS hostname registered with the operator.
ONEID_REDIRECT_URI=http://localhost:8190/realms/platform/broker/oneid/endpoint

# Off by default: our logout ends the Keycloak session only and leaves the
# OneID SSO session alone. See "Logout" in the README before turning this on.
ONEID_CALL_LOGOUT=false

# ---- Service clients (confidential, client_credentials) -------------------
USER_SERVICE_CLIENT_SECRET=user-service-secret
CADASTRAL_SERVICE_CLIENT_SECRET=cadastral-service-secret

# ---- Application ports ----------------------------------------------------
GATEWAY_PORT=8090
USER_SERVICE_PORT=8091
ORGANIZATION_SERVICE_PORT=8092
CADASTRAL_SERVICE_PORT=8093
MOCK_ONEID_PORT=8191
FRONTEND_PORT=5174
