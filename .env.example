# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Nothing here is a real credential. The OneID values are placeholders until
# the operator issues real ones by email, per the technical instruction.
#
# Secrets have no fallback anywhere else in the repository: docker compose and
# the services refuse to start without them. docs/configuration.md lists who
# reads each variable.
# ---------------------------------------------------------------------------

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5452

# ---- Keycloak -------------------------------------------------------------
KEYCLOAK_PORT=8190
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# The public URL of Keycloak. This becomes the "iss" claim of every token and
# must match issuer-uri in every service, character for character.
KEYCLOAK_HOSTNAME_URL=http://localhost:8190
KEYCLOAK_REALM=platform

# ---- OneID ----------------------------------------------------------------
# Local development points at the mock, which speaks the same wire protocol.
# Production: https://sso.egov.uz
# FRONT CHANNEL: where the browser is redirected. Must resolve from your machine.
ONEID_AUTHORIZATION_URL=http://localhost:8191/sso/oauth/Authorization.do
# BACK CHANNEL: called by Keycloak from inside its container, so it uses the
# mock's name in the Docker network. If you run mock-oneid on the host instead
# (java -jar), use http://host.docker.internal:8191/sso/oauth/Authorization.do.
ONEID_TOKEN_URL=http://mock-oneid:8191/sso/oauth/Authorization.do
ONEID_IDENTIFY_URL=http://mock-oneid:8191/sso/oauth/Authorization.do
# In production all three are https://sso.egov.uz/sso/oauth/Authorization.do:
# OneID uses one URL for every operation, chosen by response_type or grant_type.

# Issued by the OneID administrator over email for a real integration.
ONEID_CLIENT_ID=platform
ONEID_CLIENT_SECRET=platform-oneid-secret
ONEID_SCOPE=platform
# Read by nothing: Keycloak derives this URL itself. It is here as the value to
# REGISTER with the OneID operator, which is Keycloak's broker endpoint.
# The specification forbids "localhost" in redirect_uri against real OneID, so a
# real integration needs a resolvable HTTPS hostname here.
ONEID_REDIRECT_URI=http://localhost:8190/realms/platform/broker/oneid/endpoint

# Off by default: our logout ends the Keycloak session only and leaves the
# OneID SSO session alone. Turning it on makes Keycloak keep the OneID access
# token on each session, in its database, so it can call one_log_out at logout.
# Read only at realm import. See docs/flows.md, "Logout", before turning it on.
ONEID_CALL_LOGOUT=false

# ---- Service clients (confidential, client_credentials) -------------------
USER_SERVICE_CLIENT_SECRET=user-service-secret
CADASTRAL_SERVICE_CLIENT_SECRET=cadastral-service-secret

# ---- Application ports ----------------------------------------------------
GATEWAY_PORT=8090
USER_SERVICE_PORT=8091
ORGANIZATION_SERVICE_PORT=8092
CADASTRAL_SERVICE_PORT=8093
MOCK_ONEID_PORT=8191
FRONTEND_PORT=5174
