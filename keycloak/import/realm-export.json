{
  "id": "platform",
  "realm": "platform",
  "enabled": true,
  "displayName": "OneID Platform",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      { "name": "QURUVCHI",       "description": "Builder. Creates and updates construction projects." },
      { "name": "JISMONIY_SHAXS", "description": "Physical person. Baseline role for every OneID account." },
      { "name": "YURIDIK_SHAXS",  "description": "Legal entity representative. Acts on behalf of an organization." },
      { "name": "BANK",           "description": "Bank operator. Reads and records payments." },
      { "name": "ADMIN",          "description": "Administrator. Manages users." },
      { "name": "SUPER_ADMIN",    "description": "Platform administrator. NOT a superset of ADMIN — see role_permissions." }
    ],
    "client": {
      "organization-service": [
        { "name": "ORG_READ",              "description": "Machine permission: read organizations and memberships." },
        { "name": "ORG_MEMBERSHIP_SYNC",   "description": "Machine permission: reconcile memberships from OneID data." }
      ]
    }
  },

  "identityProviders": [
    {
      "alias": "oneid",
      "displayName": "OneID",
      "providerId": "oneid",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "${ONEID_AUTHORIZATION_URL}",
        "tokenUrl": "${ONEID_TOKEN_URL}",
        "userInfoUrl": "${ONEID_IDENTIFY_URL}",
        "clientId": "${ONEID_CLIENT_ID}",
        "clientSecret": "${ONEID_CLIENT_SECRET}",
        "defaultScope": "${ONEID_SCOPE}",
        "callOneIdLogout": "false",
        "updateProfileFirstLoginMode": "off",
        "syncMode": "FORCE"
      }
    }
  ],

  "clients": [
    {
      "clientId": "platform-web",
      "name": "Vue SPA (public client)",
      "description": "The browser application. Public because a browser cannot keep a secret; safety comes from PKCE and exact redirect URIs.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:5174",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:5174/*"],
      "webOrigins": ["http://localhost:5174"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5174/*"
      },
      "protocolMappers": [
        {
          "name": "token-use-user",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "token_use",
            "claim.value": "user",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-platform-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "org-tins",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_tins",
            "claim.name": "org_tins",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "identity-verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "identity_verified",
            "claim.name": "identity_verified",
            "jsonType.label": "boolean",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "user-type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "user_type",
            "claim.name": "user_type",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },

    {
      "clientId": "organization-service",
      "name": "organization-service (resource server)",
      "description": "Registered ONLY so that it can own client roles and act as a token audience. No login flow, no service account: it receives calls, it never makes them.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },

    {
      "clientId": "user-service",
      "name": "user-service (service account)",
      "description": "Confidential client. Calls organization-service to reconcile memberships.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${USER_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "token-use-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "token_use",
            "claim.value": "service",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-organization-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "organization-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },

    {
      "clientId": "cadastral-service",
      "name": "cadastral-service (service account)",
      "description": "Confidential client. Calls organization-service to validate TIN membership. Holds ORG_READ and nothing else — least privilege made concrete.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${CADASTRAL_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "token-use-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "token_use",
            "claim.value": "service",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-organization-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "organization-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "service-account-user-service",
      "enabled": true,
      "serviceAccountClientId": "user-service",
      "clientRoles": {
        "organization-service": ["ORG_MEMBERSHIP_SYNC", "ORG_READ"]
      }
    },
    {
      "username": "service-account-cadastral-service",
      "enabled": true,
      "serviceAccountClientId": "cadastral-service",
      "clientRoles": {
        "organization-service": ["ORG_READ"]
      }
    },

    {
      "username": "ali",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ali",
      "lastName": "Karimov",
      "email": "ali@example.uz",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["JISMONIY_SHAXS", "YURIDIK_SHAXS", "QURUVCHI"],
      "attributes": {
        "org_tins": ["111111111", "222222222"],
