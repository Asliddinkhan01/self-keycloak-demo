{
  "id": "demo",
  "realm": "demo",
  "enabled": true,
  "displayName": "Keycloak Microservices Demo",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>Keycloak Demo</span><small>Sign in to continue to the microservices demo</small></div>",
  "loginTheme": "demo",

  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,

  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "defaultRole": {
    "name": "default-roles-demo",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false,
    "containerId": "demo"
  },

  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Ordinary authenticated user of the demo"
      },
      {
        "name": "ADMIN",
        "description": "Administrator: may create and delete products"
      },
      {
        "name": "default-roles-demo",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "USER"
          ]
        },
        "clientRole": false,
        "containerId": "demo"
      }
    ]
  },

  "clients": [
    {
      "clientId": "demo-frontend",
      "name": "Vue frontend (public client)",
      "description": "Public OIDC client used by the Vue SPA. Public = no client secret, because a browser cannot keep a secret. Security comes from PKCE + registered redirect URIs.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-demo-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "demo-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ursula",
      "lastName": "User",
      "email": "user@demo.local",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Adam",
      "lastName": "Admin",
      "email": "admin@demo.local",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "ADMIN"
      ]
    },
    {
      "username": "nobody",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Nora",
      "lastName": "Nobody",
      "email": "nobody@demo.local",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": []
    }
  ]
}
