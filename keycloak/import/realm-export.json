    {
      "username": "admin_user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Aziza",
      "lastName": "Adminova",
      "email": "admin@example.uz",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["JISMONIY_SHAXS", "ADMIN"],
      "attributes": {
        "identity_verified": ["true"],
        "user_type": ["I"],
        "oneid_user_id": ["admin_user"]
      }
    },
    {
      "username": "super_admin",
      "enabled": true,
