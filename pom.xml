<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>uz.platform</groupId>
    <artifactId>oneid-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>oneid-platform</name>
    <description>OneID + Keycloak + Spring Boot microservice platform</description>

    <!--
        AGGREGATOR, NOT A SPRING BOOT PARENT.

        The modules do not inherit from spring-boot-starter-parent, because
        several of them are not Spring applications at all: the Keycloak
        identity provider compiles against Keycloak's SPI with its own
        dependency universe. Instead this POM IMPORTS the Spring Boot and
        Spring Cloud bills of materials below, so every module gets consistent,
        managed versions without being forced into one parent.

        Why an aggregator at all, when the earlier Keycloak demo used
        independent projects? Because four modules here depend on
        platform-security. Copying a security converter four times guarantees
        the copies drift, and a security fix would then need four changes.
    -->

    <modules>
        <!-- Phase 3 -->
        <module>platform-security</module>
        <module>user-service</module>
        <module>organization-service</module>
        <module>cadastral-service</module>
        <module>api-gateway</module>
        <module>oneid-identity-provider</module>
        <module>mock-oneid</module>
        <!-- Phase 12. Its tests run only with -Pe2e, against the running platform. -->
        <module>e2e-tests</module>
        <!--
            Added as each later phase lands, so that `mvn verify` always passes
            on a fresh clone rather than failing on an empty directory.

        -->
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.5.6</spring-boot.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <!--
            Pinned deliberately. oneid-identity-provider compiles against
            Keycloak's internal SPI, so a Keycloak upgrade is a task with a
            test pass, not a version bump. This property is the one place that
            decides which Keycloak the JAR is built for.
        -->
        <keycloak.version>26.1.5</keycloak.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Imported BEFORE Spring Boot's BOM, because the first import to
                manage an artifact wins. Boot 3.5.6 manages Testcontainers 1.21.3,
                which speaks Docker API 1.32; current Docker engines refuse
                anything older than 1.40 ("client version 1.32 is too old").
                1.21.4 is the release that fixed it. Drop this once the Boot
                version in use manages 1.21.4 or later.
            -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.21.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Keeps parameter names in the class files.

                        spring-boot-starter-parent sets this for you; this project
                        uses an aggregator plus imported BOMs instead, so it has to
                        be set explicitly. Without it Spring MVC cannot work out
                        which path variable a method argument refers to, and every
                        @PathVariable and @RequestParam without an explicit name
                        fails at runtime with "parameter name information not
                        available via reflection" — a 500, not a compile error.
                    -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                    <configuration>
                        <!--
                            Reports use each test's @DisplayName, so a run reads as
                            the list of scenarios it proves rather than as method
                            names. target/surefire-reports is then the evidence.
                        -->
                        <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
                            <usePhrasedFileName>false</usePhrasedFileName>
                            <usePhrasedTestSuiteClassName>true</usePhrasedTestSuiteClassName>
                            <usePhrasedTestCaseClassName>true</usePhrasedTestCaseClassName>
                            <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
                        </statelessTestsetReporter>
                        <consoleOutputReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5ConsoleOutputReporter">
                            <usePhrasedFileName>false</usePhrasedFileName>
                        </consoleOutputReporter>
                        <statelessTestsetInfoReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5StatelessTestsetInfoReporter">
                            <usePhrasedClassNameInRunning>true</usePhrasedClassNameInRunning>
                            <usePhrasedClassNameInTestCaseSummary>true</usePhrasedClassNameInTestCaseSummary>
                        </statelessTestsetInfoReporter>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <!--
                        Binds repackage, which turns the plain jar into an
                        executable one with a Main-Class and nested dependencies.

                        spring-boot-starter-parent binds this for you. With an
                        aggregator plus imported BOMs, merely declaring the plugin
                        does NOTHING at package time: `mvn spring-boot:run` still
                        works, which hides the problem, but `java -jar` fails with
                        "no main manifest attribute" and so would every container
                        image built from these jars. The same class of gap as the
                        -parameters flag above.
                    -->
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
